// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Zone {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // GeoJSON data stored as string for simplicity in SQLite/Postgres compatibility
  // In a full Postgres setup we could use PostGIS, but string is fine for <50 zones
  geoJson   String 
  
  // Metadata
  type      String   // "field", "tree", "grass", "path", "building", "pot"
  name      String?
  notes     String?
  
  lastWateredAt    DateTime?
  lastFertilizedAt DateTime?
  
  placements Placement[]
}

model Placement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  
  type      String   // "plant", "tree", "pot", "furniture"
  lat       Float
  lng       Float
  
  // JSON metadata (Species, Date Planted, Pot Size, etc.)
  metadata  String   @default("{}") 
}

model Seed {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  species          String
  packetQuantity   Int       @default(0)
  acquiredAt       DateTime  @default(now())
  expiryDate       DateTime?
  notes            String?
  
  seedingStart     Int?
  seedingEnd       Int?
  harvestingStart  Int?
  harvestingEnd    Int?
  
  seedlings        Seedling[]
}

model Seedling {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  seedId           String
  seed             Seed      @relation(fields: [seedId], references: [id], onDelete: Cascade)
  
  quantity         Int       @default(1)
  seededAt         DateTime  @default(now())
  expectedSproutAt DateTime?
  sproutedAt       DateTime?
  transplantedAt   DateTime?
  
  location         String?   // e.g., "Bed A", "Tray 1", "Window"
  status           String    @default("seeded") // "seeded", "sprouted", "transplanted", "failed"
  notes            String?
}
